{
  "manifest_version": 3,
  "name": "Attendance Time Calculator",
  "version": "1.0.0",
  "description": "Calculate expected logout time from attendance punch logs.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "attendance-calculator@example.com"
    }
  }
}
